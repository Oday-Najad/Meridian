# Copy this file to .env and fill in real values. .env is git-ignored — never commit it.

# --- Postgres (structured data: candidates, jobs, applications) ---
POSTGRES_USER=meridian
POSTGRES_PASSWORD=changeme
POSTGRES_DB=meridian
DATABASE_URL=postgresql://meridian:changeme@postgres:5432/meridian

# --- Vector store (matching engine embeddings) --- TBD in Phase 1, placeholder for now
VECTOR_DB_URL=

# --- Local LLM serving (Ollama) ---
OLLAMA_BASE_URL=http://ollama:11434

# --- App config ---
ENVIRONMENT=local
LOG_LEVEL=INFO
