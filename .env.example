# Copy this file to .env and fill in real values. .env is git-ignored -- never commit it.

# --- Supabase (Postgres + pgvector, Auth, Storage) ---
# Get these from your Supabase project settings, or from `supabase status`
# after running `supabase start` for local dev.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=

# --- Local LLM serving (Ollama) ---
OLLAMA_BASE_URL=http://ollama:11434

# --- Go gateway ---
GATEWAY_PORT=8080

# --- App config ---
ENVIRONMENT=local
LOG_LEVEL=INFO
